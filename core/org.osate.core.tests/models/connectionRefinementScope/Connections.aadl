package ConnectionRefinementScope
public
	process Worker
	features
		input: in data port;
		output: out data port;
		provided_data: provides data access;
		required_data: requires data access;
	end Worker;

	system Container
	end Container;

	system implementation Container.base
	subcomponents
		src: process Worker;
		dst: process Worker;
	connections
		port_link: port src.output -> dst.input;
		access_link: data access src.provided_data -> dst.required_data;
	end Container.base;

	system implementation Container.middle extends Container.base
	connections
		PORT_LINK: refined to port;
		ACCESS_LINK: refined to data access;
	end Container.middle;

	system implementation Container.leaf extends Container.middle
	connections
		port_link: refined to port;
		access_link: refined to data access;
		local_link: port dst.output -> src.input;
	end Container.leaf;
	subprogram Target
	features
		input: in parameter;
	end Target;

	subprogram Parameters
	features
		input: in parameter;
		output: out parameter;
	end Parameters;

	subprogram implementation Parameters.base
	calls
		sequence1: {
			callee: subprogram Target;
		};
	connections
		parameter_link: parameter input -> callee.input;
	end Parameters.base;

	subprogram implementation Parameters.derived extends Parameters.base
	connections
		PARAMETER_LINK: refined to parameter;
	end Parameters.derived;
end ConnectionRefinementScope;
