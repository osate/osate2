package E2E_Nested_Flows
public

	system Endpoint
		features
			input: in data port;
			output: out data port;
		flows
			fsrc: flow source output;
			fsnk: flow sink input;
			fpath: flow path input -> output;
	end Endpoint;

	system Choice extends Endpoint
	end Choice;

	system implementation Choice.two_paths
		subcomponents
			upper: system Endpoint;
			lower: system Endpoint;
		connections
			to_upper: port input -> upper.input;
			from_upper: port upper.output -> output;
			to_lower: port input -> lower.input;
			from_lower: port lower.output -> output;
		flows
			fpath: flow path input -> to_upper -> upper.fpath -> from_upper -> output;
			fpath: flow path input -> to_lower -> lower.fpath -> from_lower -> output;
	end Choice.two_paths;

	system Top
	end Top;

	system implementation Top.i
		subcomponents
			producer: system Endpoint;
			choice: system Choice.two_paths;
			right: system Endpoint;
			consumer: system Endpoint;
		connections
			enter: port producer.output -> choice.input;
			cross: port choice.output -> right.input;
			leave: port right.output -> consumer.input;
		flows
			forward_parent: end to end flow producer.fsrc -> enter -> forward_nested -> leave -> consumer.fsnk;
			nested: end to end flow choice.fpath -> cross -> right.fpath;
			parent: end to end flow producer.fsrc -> enter -> nested -> leave -> consumer.fsnk;
			starts_nested: end to end flow nested -> leave -> consumer.fsnk;
			ends_nested: end to end flow producer.fsrc -> enter -> nested;
			forward_nested: end to end flow choice.fpath -> cross -> right.fpath;
	end Top.i;

end E2E_Nested_Flows;
