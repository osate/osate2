package FlowSpecificationScope
public
	with FlowScopeBase;

	system Middle extends FlowScopeBase::Base
	flows
		SOURCE1: refined to flow source;
		SINK1: refined to flow sink;
		PATH1: refined to flow path;
	end Middle;

	system Leaf extends Middle
	flows
		source1: refined to flow source;
		sink1: refined to flow sink;
		path1: refined to flow path;
		local_flow: flow source output;
	end Leaf;

	system implementation Middle.middle extends FlowScopeBase::Base.base
	flows
		ETE1: refined to end to end flow;
	end Middle.middle;

	system implementation Leaf.leaf extends Middle.middle
	flows
		SOURCE1: flow source worker.source1 -> outgoing -> output;
		SINK1: flow sink input -> incoming -> worker.sink1;
		PATH1: flow path input -> incoming -> worker.path1 -> outgoing -> output;
		ete1: refined to end to end flow;
		local_ete: end to end flow worker.source1 -> bridge -> other.sink1;
	end Leaf.leaf;
end FlowSpecificationScope;
