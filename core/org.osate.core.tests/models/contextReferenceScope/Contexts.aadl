package ContextReferenceScope
public
	with ContextProperties;

	feature group Inner
	features
		signal: out event port;
	end Inner;
	feature group Outer
	features
		inner1: feature group Inner;
	end Outer;

	abstract Worker
	features
		input: in event port;
		output: out event port;
		group1: feature group Outer;
	flows
		source1: flow source output;
		sink1: flow sink input;
		path1: flow path input -> output;
	modes
		child_a: initial mode;
		child_b: mode;
	end Worker;

	abstract Parent
	prototypes
		worker_type: abstract Worker;
		group_type: feature group Outer;
	features
		input: in event port;
		output: out event port;
		group1: feature group group_type;
	flows
		path1: flow path input -> output;
		group_source: flow source group1.inner1.signal;
	modes
		parent_a: initial mode;
		parent_b: mode;
	end Parent;

	abstract implementation Parent.i
	subcomponents
		left: abstract worker_type in modes (parent_a => CHILD_A, parent_b => CHILD_B);
		right: abstract Worker {
			ContextProperties::Num => 1 large in modes (CHILD_A), 1 large in modes (CHILD_B);
			ContextProperties::Ref => reference (input);
		};
	connections
		incoming: port input -> left.input;
		outgoing: port left.output -> output;
		bridge: port left.output -> right.input;
		nested: feature left.group1.inner1.signal -> right.input;
	flows
		path1: flow path input -> incoming -> left.path1 -> outgoing -> output;
		ete1: end to end flow left.source1 -> bridge -> right.sink1;
	modes
		change: parent_a -[LEFT.output]-> parent_b;
	properties
		ContextProperties::Flag => true applies to left.group1.inner1.signal;
		ContextProperties::Ref => reference (left.group1.inner1.signal);
		ContextProperties::Num => 2 large in modes (CHILD_B), 2 large in modes (CHILD_A) applies to right.input;
		ContextProperties::Num => 3 large in modes (PARENT_A), 3 large in modes (PARENT_B) applies to input;
		ContextProperties::Value => [amount => 4 LARGE;];
	end Parent.i;

	abstract Bound extends Parent (worker_type => abstract Worker, group_type => feature group Outer)
	end Bound;
	abstract implementation Bound.i extends Parent.i
	subcomponents
		left: refined to abstract;
	end Bound.i;

	subprogram Action
	features
		param: in parameter;
	end Action;
	subprogram implementation Action.i
	end Action.i;
	subprogram group Services
	features
		run1: provides subprogram access Action;
	end Services;
	feature group CallGroup
	features
		run1: provides subprogram access Action;
	end CallGroup;
	thread Caller
	features
		services: requires subprogram group access Services;
		group1: feature group CallGroup;
		param: in data port;
	end Caller;
	thread implementation Caller.i
	subcomponents
		services_sub: subprogram group Services;
	calls
		sequence1: {
			via_access: subprogram services.RUN1;
			via_group: subprogram group1.RUN1;
			via_subcomponent: subprogram services_sub.RUN1;
			via_type: subprogram Action.i;
		};
	connections
		argument: parameter param -> via_access.param;
	end Caller.i;
end ContextReferenceScope;
