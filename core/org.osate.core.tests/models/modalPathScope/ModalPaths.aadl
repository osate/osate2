package ModalPathScope
public
	system Worker
	features
		input: in event port;
		output: out event port;
	flows
		path1: flow path input -> output;
		source1: flow source output;
		sink1: flow sink input;
	end Worker;

	system Base
	features
		input: in event port;
		output: out event port;
		tick: in event port;
	flows
		path1: flow path input -> output in modes (idle, activate);
	modes
		idle: initial mode;
		active: mode;
		activate: idle -[tick]-> active;
	end Base;

	system Derived extends Base
	flows
		path2: flow path input -> output in modes (IDLE, ACTIVATE);
	end Derived;

	system implementation Derived.base
	subcomponents
		worker1: system Worker;
		source1: system Worker;
		sink1: system Worker;
	connections
		incoming: port input -> worker1.input in modes (IDLE, ACTIVATE);
		outgoing: port worker1.output -> output in modes (IDLE, ACTIVATE);
		link1: port source1.output -> sink1.input in modes (IDLE, ACTIVATE);
	flows
		path1: flow path input -> incoming -> worker1.path1 -> outgoing -> output
			in modes (IDLE, ACTIVATE);
		ete1: end to end flow source1.source1 -> link1 -> sink1.sink1 in modes (IDLE, ACTIVATE);
	end Derived.base;

	system implementation Derived.leaf extends Derived.base
	connections
		incoming: refined to port in modes (IDLE, ACTIVE, ACTIVATE);
	end Derived.leaf;

	system ImplementationModes
	features
		tick: in event port;
	end ImplementationModes;

	system implementation ImplementationModes.base
	subcomponents
		source1: system Worker;
		sink1: system Worker;
	connections
		link1: port source1.output -> sink1.input in modes (waiting, advance);
	modes
		waiting: initial mode;
		running: mode;
		advance: waiting -[tick]-> running;
	end ImplementationModes.base;

	system implementation ImplementationModes.leaf extends ImplementationModes.base
	connections
		link1: refined to port in modes (WAITING, ADVANCE);
	flows
		ete1: end to end flow source1.source1 -> link1 -> sink1.sink1 in modes (WAITING, ADVANCE);
	end ImplementationModes.leaf;

	system Other
	modes
		foreign_mode: initial mode;
	end Other;
end ModalPathScope;
