package GlobalClient
public
	with GlobalLibrary, Globals;
	L renames package GlobalLibrary;
	PayloadAlias renames data GlobalLibrary::Payload;
	ActionAlias renames subprogram GlobalLibrary::Action;
	PortsAlias renames feature group GlobalLibrary::Ports;
	abstract Container
	features
		port1: in data port GlobalLibrary::Payload;
		port2: in data port PayloadAlias;
		bus1: requires bus access GlobalLibrary::Link.i;
		group1: feature group PortsAlias;
	end Container;
	abstract implementation Container.i
	subcomponents
		value1: data L::Payload.i [Globals::Count];
	properties
		Globals::Size => Globals::Count;
		Globals::Selection => FIRST;
	end Container.i;
	subprogram Caller
	end Caller;
	subprogram implementation Caller.i
	calls
		sequence1: {
			type_call: subprogram GlobalLibrary::Action;
			implementation_call: subprogram GlobalLibrary::Action.i;
			alias_call: subprogram ActionAlias.i;
			package_alias_call: subprogram L::Action.i;
		};
	end Caller.i;
private
	data Local
	end Local;
	data implementation Local.i
	subcomponents
		value1: data PayloadAlias;
		value2: data L::Payload.i;
	properties
		Data_Size => 16 Bytes;
	end Local.i;
end GlobalClient;
