-- Historical reproducer for issue #565, used as a characterization fixture for
-- the across-first connection traversal enhancement (issue #3037).
--
-- Two inverse feature groups are the shape issue #565 reported as duplicate
-- enumeration, and the reason the connection phase once ended in a reverse-order
-- duplicate check. This fixture pins the connection set the model actually has:
-- two connections, one per legal endpoint orientation, and no third to suppress.
--
-- Do not add arrays, Connection_Pattern, or Connection_Set to this fixture.
-- Separate fixtures cover structural expansion.
package issue565
public

	data MsgType
	end MsgType;

	feature group FGType
		features
			inPort: in out data port MsgType;
	end FGType;

	process Proc
		features
			fgPorts: feature group FGType;
	end Proc;

	process InverseProc
		features
			fgPorts: feature group inverse of FGType;
	end InverseProc;

	system sub
		features
			fgPorts: feature group inverse of FGType;
	end sub;

	system implementation sub.i
		subcomponents
			iproc: process InverseProc;
		connections
			c2: feature group fgPorts <-> iproc.fgPorts;
	end sub.i;

	system Sys
	end Sys;

	system implementation Sys.Imp
		subcomponents
			proc: process Proc;
			sub: system sub.i;
		connections
			c1: feature group proc.fgPorts <-> sub.fgPorts;
	end Sys.Imp;

end issue565;
