package Issue3032ContainedProperties
public
	thread Producer
	features
		outp: out data port;
	end Producer;

	thread Consumer
	features
		inp: in data port;
	end Consumer;

	process Inner
	end Inner;

	-- The connection expands into one connection instance per array element.
	process implementation Inner.i
	subcomponents
		producers: thread Producer[2];
		consumers: thread Consumer[2];
	connections
		c: port producers.outp -> consumers.inp;
	end Inner.i;

	system Top
	end Top;

	-- A contained property association on a connection that expands. Every connection instance the
	-- expansion produces for that connection has to carry the value.
	system implementation Top.uniform
	subcomponents
		nested: process Inner.i;
	properties
		Communication_Properties::Timing => delayed applies to nested.c;
	end Top.uniform;

	-- The component that owns the connection is itself an array and only one element is named by the
	-- containment path. Only the connection instances inside that element may carry the value.
	system implementation Top.perElement
	subcomponents
		nested: process Inner.i[2];
	properties
		Communication_Properties::Timing => delayed applies to nested[2].c;
	end Top.perElement;
end Issue3032ContainedProperties;
