package PrototypeBindingScope
public
	abstract Payload
	prototypes
		nested: feature;
	end Payload;

	abstract implementation Payload.i
	end Payload.i;

	feature group Group1
	prototypes
		inner: feature;
	end Group1;

	feature group BoundGroup extends Group1 (INNER => in data port)
	end BoundGroup;

	abstract Template
	prototypes
		comp: abstract;
		group_proto: feature group;
		feat: feature;
	features
		event1: in event port;
	end Template;

	abstract RefinedTemplate extends Template
	prototypes
		comp: refined to abstract;
		group_proto: refined to feature group;
		feat: refined to feature;
	end RefinedTemplate;

	abstract Bound extends RefinedTemplate (
		COMP => abstract Payload (NESTED => in data port),
		GROUP_PROTO => feature group Group1 (INNER => in data port),
		FEAT => in data port
	)
	prototypes
		local_proto: abstract;
	end Bound;

	abstract implementation Template.base (
		COMP => abstract Payload,
		GROUP_PROTO => feature group Group1,
		FEAT => in data port
	)
	end Template.base;

	abstract implementation Template.extended extends Template.base (COMP => abstract Payload)
	end Template.extended;

	abstract Container
	prototypes
		comp: abstract;
		nested: feature;
		inner: feature;
	end Container;

	abstract implementation Container.i
	subcomponents
		subject: abstract RefinedTemplate (
			COMP => abstract Payload (NESTED => in data port),
			GROUP_PROTO => feature group Group1 (INNER => in data port),
			FEAT => in data port
		);
	end Container.i;
end PrototypeBindingScope;
