property set Issue3323 is
    U: type units (small, large => SMALL * 10);
    Amount: type aadlinteger 0 small .. 100 large units Issue3323::U;
    Interval: type range of Issue3323::Amount;
    Choice: type enumeration (first, second);
    OtherChoice: type enumeration (first, third);
    Inner: type record (
        selection: Issue3323::Choice;
        amount: Issue3323::Amount;
    );
    Outer: type record (
        inner: Issue3323::Inner;
        amounts: list of Issue3323::Amount;
    );
    Count: constant aadlinteger => 2;
    Selected: constant Issue3323::Choice => FIRST;
    RecordConstant: constant Issue3323::Outer => [
        inner => [selection => first; amount => 2 LARGE;];
        amounts => (1 small, 2 large);
    ];
    Value: Issue3323::Outer applies to (all);
    Selection: Issue3323::Choice => second applies to (all);
    Span: Issue3323::Interval => 1 small .. 2 large applies to (all);
    Size: aadlinteger => Issue3323::Count applies to (all);
    OtherSize: aadlinteger => Issue3323::Size applies to (all);
end Issue3323;
