package LocalReferenceScope
public
	abstract Worker
	features
		input: in event port;
		output: out event port;
	flows
		source1: flow source output;
		sink1: flow sink input;
		path1: flow path input -> output;
	modes
		c1: initial mode;
		c2: mode;
	end Worker;

	abstract Consumer
	prototypes
		formal: feature;
	end Consumer;

	abstract Base
	prototypes
		fp: feature;
		cp: abstract;
		gp: feature group;
	features
		input: in event port;
		output: out event port;
		generic: prototype FP;
	flows
		path1: flow path input -> output;
	modes
		m1: initial mode;
		m2: mode;
		forward: M1 -[input]-> M2;
	end Base;

	abstract Middle extends Base
	prototypes
		fp: refined to feature;
		cp: refined to abstract;
		gp: refined to feature group;
	features
		INPUT: refined to in event port;
	end Middle;

	abstract Leaf extends Middle
	prototypes
		FP: refined to feature;
		CP: refined to abstract;
		GP: refined to feature group;
	features
		input: refined to in event port;
		local_generic: prototype fp;
	end Leaf;

	abstract implementation Base.base
	subcomponents
		child: abstract Worker in modes (M1 => c1, M2 => c2);
		other: abstract Worker in modes (m1, m2);
	connections
		incoming: port input -> child.input;
		outgoing: port child.output -> output;
		bridge: port child.output -> other.input;
	flows
		path1: flow path input -> incoming -> child.path1 -> outgoing -> output;
		ete1: end to end flow child.source1 -> bridge -> other.sink1;
	modes
		backward: M2 -[CHILD.output]-> M1;
	end Base.base;

	abstract implementation Middle.middle extends Base.base
	subcomponents
		CHILD: refined to abstract Worker;
	end Middle.middle;

	abstract implementation Leaf.leaf extends Middle.middle
	subcomponents
		child: refined to abstract Worker;
		consumer1: abstract Consumer (formal => feature FP) in modes (M1);
	connections
		local_connection: port input -> CHILD.input;
	end Leaf.leaf;

	abstract implementation Base.prototype_refinement
	prototypes
		cp: refined to abstract;
	end Base.prototype_refinement;
end LocalReferenceScope;
