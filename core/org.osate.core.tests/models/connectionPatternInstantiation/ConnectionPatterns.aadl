-- One implementation per connection pattern, so that a test instantiates exactly the pattern it is
-- about. The arrays hold five elements wherever the pattern shifts indices, which is enough to tell a
-- single step from a double step in the interior of the dimension and to show both wrapping elements.
-- The ports are event data ports so that the patterns that give a destination element more than one
-- incoming connection do not add unrelated diagnostics about data ports.
package ConnectionPatterns
public
	device Sensor
		features
			in_p: in event data port;
			out_p: out event data port;
	end Sensor;

	system Pair
	end Pair;

	system implementation Pair.one_to_one
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((One_To_One));
			};
	end Pair.one_to_one;

	system implementation Pair.next
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((Next));
			};
	end Pair.next;

	system implementation Pair.previous
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((Previous));
			};
	end Pair.previous;

	system implementation Pair.cyclic_next
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((Cyclic_Next));
			};
	end Pair.cyclic_next;

	system implementation Pair.cyclic_previous
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((Cyclic_Previous));
			};
	end Pair.cyclic_previous;

	system implementation Pair.next_next
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((Next_Next));
			};
	end Pair.next_next;

	system implementation Pair.previous_previous
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((Previous_Previous));
			};
	end Pair.previous_previous;

	-- Issue #3085: the interior of the dimension is connected to the next element instead of the one
	-- after next. The test that instantiates this pins that as it is today.
	system implementation Pair.cyclic_next_next
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((Cyclic_Next_Next));
			};
	end Pair.cyclic_next_next;

	-- Issue #3085, the mirror image of Pair.cyclic_next_next.
	system implementation Pair.cyclic_previous_previous
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((Cyclic_Previous_Previous));
			};
	end Pair.cyclic_previous_previous;

	system implementation Pair.even_to_even
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((Even_To_Even));
			};
	end Pair.even_to_even;

	system implementation Pair.odd_to_odd
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((Odd_To_Odd));
			};
	end Pair.odd_to_odd;

	-- Two pattern values. The outer list collects alternative patterns, and the connection instances
	-- are the union of what each of them produces.
	system implementation Pair.next_and_previous
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((Next), (Previous));
			};
	end Pair.next_and_previous;

	-- All_To_All applies to arrays of different sizes as well, so this one does not use five elements.
	system implementation Pair.all_to_all
		subcomponents
			src: device Sensor [3];
			dst: device Sensor [2];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((All_To_All));
			};
	end Pair.all_to_all;

	-- One_To_All is the pattern for a destination of higher dimensionality than the source.
	system implementation Pair.one_to_all
		subcomponents
			src: device Sensor;
			dst: device Sensor [4];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((One_To_All));
			};
	end Pair.one_to_all;

	-- All_To_One is the pattern for a destination of lower dimensionality than the source.
	system implementation Pair.all_to_one
		subcomponents
			src: device Sensor [4];
			dst: device Sensor;
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((All_To_One));
			};
	end Pair.all_to_one;

	-- One pattern value per dimension, in the order the dimensions are declared.
	system implementation Pair.two_dimensions
		subcomponents
			src: device Sensor [2][3];
			dst: device Sensor [2][3];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((One_To_One, Next));
			};
	end Pair.two_dimensions;

	-- A pattern that pairs elements up needs both dimensions to have the same size.
	system implementation Pair.size_mismatch
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [4];
		connections
			c: port src.out_p -> dst.in_p {
				Communication_Properties::Connection_Pattern => ((One_To_One));
			};
	end Pair.size_mismatch;

	-- No Connection_Pattern at all: the default expansion pairs the dimensions one to one.
	system implementation Pair.no_pattern
		subcomponents
			src: device Sensor [5];
			dst: device Sensor [5];
		connections
			c: port src.out_p -> dst.in_p;
	end Pair.no_pattern;
end ConnectionPatterns;
