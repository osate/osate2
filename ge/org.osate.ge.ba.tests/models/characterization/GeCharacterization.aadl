package Issue2445_Ge_Characterization
public
	with Base_Types;

	thread behavior_owner
	features
		trigger: in event port;
		existing_feature: out data port Base_Types::Integer;
	modes
		existing_mode: initial mode;
	annex behavior_specification {**
		variables
			value: Base_Types::Integer;
		states
			source: initial complete state;
			destination: final state;
		transitions
			named_transition: source -[on dispatch trigger]-> destination {
				value := 1
			};
	**};
	end behavior_owner;
end Issue2445_Ge_Characterization;
