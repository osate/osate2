package RenameUses
public
	with RenameDefinitions;
	annex EMV2 {**
		error types
			Failure: type;
		end types;
	**};
	system Example extends RenameDefinitions::Base
		flows
			path1: flow path input -> output;
		annex EMV2 {**
			use types RenameUses;
			error propagations
				input: in propagation {Failure};
				output: out propagation {Failure};
			flows
				error_path: error path input -> output;
				error_sink: error sink input;
				error_source: error source output;
			end propagations;
		**};
	end Example;
end RenameUses;
