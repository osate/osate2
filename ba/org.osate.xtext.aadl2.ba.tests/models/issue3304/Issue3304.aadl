package Issue3304
public
	with Base_Types;
	annex EMV2 {**
		error types
			Failure: type;
		end types;
	**};
	system Example
		features
			input: in event data port Base_Types::Integer;
			output: out event data port Base_Types::Integer;
		flows
			path1: flow path input -> output;
		annex EMV2 {**
			use types Issue3304;
			error propagations
				input: in propagation {Failure};
				output: out propagation {Failure};
			flows
				error_path: error path input -> output;
				error_sink: error sink input;
				error_source: error source output;
			end propagations;
		**};
	end Example;
	system implementation Example.i
		subcomponents
			DesiredPositionState: data Base_Types::Integer;
		annex behavior_specification {**
			variables
				counter: Base_Types::Integer;
			states
				idle: initial state;
				done: final state;
			transitions
				idle -[]-> done {
					counter := input;
					counter := input'count;
					DesiredPositionState := counter;
					output!(DesiredPositionState)
				};
		**};
	end Example.i;
end Issue3304;
