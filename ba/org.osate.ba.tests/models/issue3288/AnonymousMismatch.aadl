package AnonymousMismatch
public
	with Data_Model;

	data position_change
	end position_change;

	data implementation position_change.fields
		subcomponents
			step_total: data {
				Data_Model::Data_Representation => Integer;
			};
			open_valve: data {
				Data_Model::Data_Representation => Boolean;
			};
	end position_change.fields;

	abstract holder
	end holder;

	abstract implementation holder.impl
		subcomponents
			pending: data position_change.fields;
		annex behavior_specification {**
			states
				start: initial state;
				phase_two: state;
				phase_three: state;
				done: final state;
			transitions
				-- Reading the representation of a classifier-less field is what makes these mismatches visible: an
				-- integer field does not hold a Boolean value, in either direction.
				assigned: start -[]-> phase_two {
					pending.step_total := pending.open_valve
				};
				reversed: phase_two -[]-> phase_three {
					pending.open_valve := pending.step_total
				};
				-- Both operands have a declared representation now, so they are checked against each other: a Boolean
				-- field does not agree with an integer literal. The diagnostic names both representations rather
				-- than reporting the field as untyped.
				computed: phase_three -[]-> done {
					pending.step_total := pending.open_valve - 1
				};
		**};
	end holder.impl;
end AnonymousMismatch;
