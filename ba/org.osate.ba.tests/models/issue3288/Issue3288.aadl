package Issue3288
public
	with Data_Model;

	data element_type
		properties
			Data_Model::Data_Representation => Integer;
	end element_type;

	data position_change
	end position_change;

	-- A field of a data implementation may be declared without a classifier, with the Data Model Annex properties
	-- attached to the subcomponent itself. That subcomponent is the only element that declares the representation of
	-- the field, so it is where the representation has to be read from.
	data implementation position_change.fields
		subcomponents
			step_total: data {
				Data_Model::Data_Representation => Integer;
				Data_Model::Integer_Range => 0 .. 100;
			};
			step_rate: data {
				Data_Model::Data_Representation => Integer;
			};
			open_valve: data {
				Data_Model::Data_Representation => Boolean;
			};
			readings: data {
				Data_Model::Data_Representation => Array;
				Data_Model::Base_Type => (classifier (element_type));
				Data_Model::Dimension => (4);
			};
	end position_change.fields;

	abstract holder
	end holder;

	abstract implementation holder.impl
		subcomponents
			pending: data position_change.fields;
		annex behavior_specification {**
			states
				start: initial state;
				phase_two: state;
				phase_three: state;
				done: final state;
			transitions
				-- An operator that requires a numeric representation applies to an integer field, in a transition
				-- condition and in an action.
				guarded: start -[pending.step_total > 0]-> phase_two {
					pending.step_total := pending.step_total - 1
				};
				-- A relational expression over integer fields assigns to a Boolean field.
				compared: phase_two -[pending.step_total = 0]-> phase_three {
					pending.open_valve := pending.step_rate >= 1
				};
				-- An array field declares its element type and extent the same way, so an indexed read has the
				-- representation of the element type.
				indexed: phase_three -[]-> done {
					pending.step_total := pending.readings[1] + 1
				};
		**};
	end holder.impl;
end Issue3288;
