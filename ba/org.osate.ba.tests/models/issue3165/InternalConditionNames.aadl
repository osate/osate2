package InternalConditionNames
public
	-- The AS5506/3 Rev A D.3 internal_condition production lists internal_port_names, which are the internal event and
	-- internal event data features of the containing component. An incoming port, a behavior variable, and a data
	-- subcomponent are all visible under the annex's naming rules, and none of them is an internal port.
	data counter
	end counter;

	abstract names
	features
		trigger: in event port;
	end names;

	abstract implementation names.not_internal_ports
	subcomponents
		tally: data counter;
	internal features
		raised: event;
	annex behavior_specification {**
		variables
			progress: counter;
		states
			start: initial state;
			working: state;
			done: final state;
		transitions
			enter_working: start -[ ]-> working;
			on_incoming_port: working -[ on internal trigger ]-> done;
			on_variable: working -[ on internal progress ]-> done;
			on_data_subcomponent: working -[ on internal tally ]-> done;
	**};
	end names.not_internal_ports;
end InternalConditionNames;
