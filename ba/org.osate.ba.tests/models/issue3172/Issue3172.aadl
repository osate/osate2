package Issue3172
public
	with Base_Types;

	-- AS5506/3 Rev A D.7 admits self as the component element of a property reference: it names the component that
	-- contains the annex subclause. Both threads declare the complete state D.3.(L3) requires and dispatch out of it,
	-- so every action below is legal and the strict model must preserve each reference.
	thread reader
	features
		input: in data port Base_Types::Integer;
	properties
		Priority => 1;
		Dispatch_Protocol => Periodic;
		Period => 10 ms;
	annex behavior_specification {**
		variables
			value: Base_Types::Integer;
		states
			waiting: initial complete final state;
		transitions
			-- The property is associated with the containing type, named locally and by its unique name, and the
			-- last reference names a property the type leaves unset.
			waiting -[ on dispatch ]-> waiting {
				value := self#Priority;
				value := self#Thread_Properties::Priority;
				value := self#Deadline;
				value := self.input
			};
	**};
	end reader;

	thread writer
	properties
		Priority => 2;
		Dispatch_Protocol => Periodic;
		Period => 20 ms;
	end writer;

	-- The subclause of an implementation resolves self to that implementation, whose property value comes from its
	-- type.
	thread implementation writer.impl
	subcomponents
		storage: data Base_Types::Integer;
	annex behavior_specification {**
		variables
			value: Base_Types::Integer;
		states
			waiting: initial complete final state;
		transitions
			waiting -[ on dispatch ]-> waiting {
				value := self#Priority;
				value := self.storage
			};
	**};
	end writer.impl;
end Issue3172;
