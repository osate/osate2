package InvalidEnumerators
public
	with Data_Model;

	data direction_type
		properties
			Data_Model::Data_Representation => Enum;
			Data_Model::Enumerators => ("Opening", "Closing");
	end direction_type;

	-- A second enumeration data type whose enumerators are unrelated to direction_type's.
	data signal_type
		properties
			Data_Model::Data_Representation => Enum;
			Data_Model::Enumerators => ("Rising", "Falling");
	end signal_type;

	data int_type
		properties
			Data_Model::Data_Representation => Integer;
	end int_type;

	abstract host
	end host;

	abstract implementation host.impl
		subcomponents
			state_value: data direction_type;
			other_value: data signal_type;
			int_value: data int_type;
		annex behavior_specification {**
			states
				start: initial state;
				done: final state;
			transitions
				-- The name is not an element of the Enumerators list.
				absent: start -[]-> done {
					state_value := direction_type#Data_Model::Enumerators.NotAnEnumerator
				};
				-- An enumerator of a different enumeration data type does not conform.
				mismatch: start -[]-> done {
					state_value := signal_type#Data_Model::Enumerators.Rising
				};
				-- An enumeration value is not a numeric operand.
				numeric: start -[]-> done {
					int_value := direction_type#Data_Model::Enumerators.Opening + 1
				};
				-- A diagnostic after an unresolvable property field is still reported.
				later: start -[]-> done {
					int_value := other_value
				};
		**};
	end host.impl;
end InvalidEnumerators;
