package Issue3282
public
	with Data_Model;

	-- A Data Model Annex enumeration data type. Each enumerator is a string literal inside the Enumerators
	-- association, not a declared AADL enumeration literal, so AS5506/3 Rev A D.7 leaves a prefixed property
	-- reference as the only way to name one: value_constant has no enumeration-literal alternative.
	data direction_type
		properties
			Data_Model::Data_Representation => Enum;
			Data_Model::Enumerators => ("Opening", "Closing");
	end direction_type;

	data record_type
	end record_type;

	-- An anonymous data subcomponent carries the enumeration on the subcomponent itself, so an element-prefixed
	-- reference is the only form that can reach its enumerators.
	data implementation record_type.impl
		subcomponents
			flag: data {
				Data_Model::Data_Representation => Enum;
				Data_Model::Enumerators => ("Rising", "Falling");
			};
	end record_type.impl;

	data bool_type
		properties
			Data_Model::Data_Representation => Boolean;
	end bool_type;

	abstract host
	end host;

	abstract implementation host.impl
		subcomponents
			state_value: data direction_type;
			record_value: data record_type.impl;
			bool_value: data bool_type;
		annex behavior_specification {**
			states
				start: initial state;
				done: final state;
			transitions
				-- A classifier-prefixed reference names an enumerator of the classifier that declares it.
				assigned: start -[]-> done {
					state_value := direction_type#Data_Model::Enumerators.Opening;
					state_value := direction_type#Data_Model::Enumerators.Closing
				};
				-- An element-prefixed reference takes the enumeration from the prefix element, either through the
				-- element's own association or through its data classifier.
				prefixed: start -[]-> done {
					state_value := state_value#Data_Model::Enumerators.Closing;
					bool_value := record_value.flag = record_value.flag#Data_Model::Enumerators.Rising
				};
				-- An enumerator is a legal relational operand and yields a boolean.
				compared: start -[]-> done {
					bool_value := state_value = direction_type#Data_Model::Enumerators.Opening
				};
				guarded: start -[]-> done {
					if (record_value.flag = record_value.flag#Data_Model::Enumerators.Falling)
						state_value := direction_type#Data_Model::Enumerators.Closing
					end if
				};
		**};
	end host.impl;
end Issue3282;
