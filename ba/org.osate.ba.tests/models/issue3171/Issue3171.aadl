package Issue3171
public
	with Base_Types;

	feature group readings
	features
		pulse: in event port;
	end readings;

	-- AS5506/3 Rev. A lists 'updated among the D.5 port services and admits it in the D.7 value_variable production as
	-- "port_name ' updated", beside 'count and 'fresh. The value is a universal Boolean, equivalent to the core Updated
	-- runtime service: true when new values were received in the port since its last freeze, and it does not freeze the
	-- port. So it carries no data classifier of its own and applies to a data-less event port as well as to a port that
	-- carries data.
	--
	-- Every port named here is incoming, which is what that description of the value is about. The production spells
	-- "port_name" rather than the "incoming_port_name" it uses for a plain port read, so it admits an outgoing port too,
	-- but nothing in D.5 or D.7 says what the value would mean there; this model takes no position on that case.
	thread sampler
	features
		reading: in data port Base_Types::Integer;
		request: in event data port Base_Types::Integer;
		trigger: in event port;
		bundle: feature group readings;
	properties
		Dispatch_Protocol => Sporadic;
	end sampler;

	thread implementation sampler.i
	annex behavior_specification {**
		variables
			changed: Base_Types::Boolean;
		states
			start: initial state;
			checking: state;
			bundling: state;
			done: complete final state;
		transitions
			data_port: start -[ reading'updated ]-> checking;
			event_data_port: checking -[ request'updated ]-> bundling { changed := trigger'updated };
			feature_group_port: bundling -[ bundle.pulse'updated ]-> done;
	**};
	end sampler.i;
end Issue3171;
