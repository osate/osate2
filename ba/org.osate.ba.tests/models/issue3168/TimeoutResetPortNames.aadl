package TimeoutResetPortNames
public
	with Base_Types;

	-- The AS5506/3 Rev A D.4 timeout_reset_port production names an event port or an event data port. The grammar
	-- admits the same generic reference here as everywhere else, so a reset-port list can also name something the
	-- strict model has no reset port for. All three names below are visible under the D.3 naming rules and none of
	-- them is a reset port.
	thread sensor
	features
		sample: in data port Base_Types::Integer;
	properties
		Dispatch_Protocol => Timed;
		Period => 100 ms;
	end sensor;

	thread implementation sensor.polling
	subcomponents
		cache: data Base_Types::Integer;
	annex behavior_specification {**
		variables
			tally: Base_Types::Integer;
		states
			ready: initial complete state;
			stopped: final state;
		transitions
			bad_resets: ready -[ on dispatch timeout (sample or tally or cache) 20 ms ]-> stopped;
	**};
	end sensor.polling;
end TimeoutResetPortNames;
