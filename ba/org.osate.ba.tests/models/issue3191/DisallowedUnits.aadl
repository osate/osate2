package DisallowedUnits
public
	with Base_Types;
	with Issue3191Properties;

	thread reader
	features
		input : in data port Base_Types::Integer;
	properties
		Issue3191Properties::Unitless_Int => 7;
	end reader;

	thread implementation reader.impl
	annex behavior_specification {**
		variables
			i : Base_Types::Integer;
			r : Base_Types::Float;
			b : Base_Types::Boolean;
			s : Base_Types::String;
		states
			start : initial state;
			done : complete final state;
		transitions
			start -[]-> done {
				i := #Issue3191Properties::Size_Int;
				r := #Issue3191Properties::Size_Real;
				i := self#Issue3191Properties::Size_Int;
				i := input#Issue3191Properties::Size_Int;
				i := self#Issue3191Properties::Size_Without_Default;
				i := #Issue3191Properties::Size_Constant;
				i := #Issue3191Properties::Other;
				i := #Issue3191Properties::Record_Value.size;
				i := self#Issue3191Properties::Record_Without_Default.size
			};
	**};
	end reader.impl;
end DisallowedUnits;
