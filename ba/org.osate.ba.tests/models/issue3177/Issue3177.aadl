package Issue3177
public
	with Base_Types;

	subprogram evaluate
	annex behavior_specification {**
		variables
			total : Base_Types::Integer;
			result : Base_Types::Integer;
			left : Base_Types::Boolean;
			middle : Base_Types::Boolean;
			right : Base_Types::Boolean;
			flag : Base_Types::Boolean;
		states
			start : initial state;
			done : final state;
		transitions
			start -[ ]-> done {
				-- D.7 puts every logical operator on one precedence level and associates a level from left to
				-- right, so this is (left or middle) and right.
				flag := left or middle and right;
				-- The parenthesized group is a single operand of and, not a pair of relations spliced into the
				-- enclosing value expression.
				flag := left and (middle or right);
				-- The binary numeric operator binds tighter than the unary adding operator, so this is -(2 ** 2).
				result := -2 ** 2;
				-- The unary adding operator applies to the whole first term, so this is -(total mod 3). The sign
				-- matters: -(1 mod 3) is -1 while (-1) mod 3 is 2.
				result := -total mod 3;
				-- factor admits one exponentiation, so a chain needs explicit parentheses.
				result := (total ** 2) ** 3
			};
	**};
	end evaluate;
end Issue3177;
