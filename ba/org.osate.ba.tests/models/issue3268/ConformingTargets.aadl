package ConformingTargets
public

with Base_Types;

feature group signals
features
	channel : out event data port Base_Types::Integer;
end signals;

data buffer
end buffer;

data implementation buffer.impl
subcomponents
	field : data Base_Types::Integer;
end buffer.impl;

thread worker
features
	incoming : in data port Base_Types::Integer;
	outgoing : out data port Base_Types::Integer;
	queued_out : out event data port Base_Types::Integer;
	both_ways : in out data port Base_Types::Integer;
	group_output : feature group signals;
	shared : requires data access Base_Types::Integer;
end worker;

thread implementation worker.impl
subcomponents
	persistent : data buffer.impl;
annex behavior_specification {**
	variables
		value : Base_Types::Integer := 0;
	states
		start : initial state;
		done : complete final state;
	transitions
		start -[]-> done {
			outgoing := 1;
			queued_out := 2;
			both_ways := 3;
			group_output.channel := 4;
			value := incoming;
			persistent.field := value;
			shared := 5
		};
**};
end worker.impl;

end ConformingTargets;
