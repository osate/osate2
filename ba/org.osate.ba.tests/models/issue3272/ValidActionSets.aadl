package ValidActionSets
public
	with Base_Types;
	subprogram writer
	features
		result : out parameter Base_Types::Integer;
	end writer;
	subprogram implementation writer.i
	end writer.i;
	subprogram updater
	features
		changed : in out parameter Base_Types::Integer;
	end updater;
	subprogram mixed
	features
		argument : in parameter Base_Types::Integer;
		result : out parameter Base_Types::Integer;
	end mixed;
	subprogram port_writer
	features
		argument : in parameter Base_Types::Integer;
		signal : out event data port Base_Types::Integer;
	end port_writer;
	abstract host
	features
		input : in event data port Base_Types::Integer;
		output : out event data port Base_Types::Integer;
		other_output : out event data port Base_Types::Integer;
		call_access : requires subprogram access writer;
	end host;
	abstract implementation host.i
	subcomponents
		local_call : subprogram writer.i;
	annex behavior_specification {**
		variables
			value : Base_Types::Integer := 0;
			other : Base_Types::Integer := 0;
		states
			start : initial state;
			done : final state;
		transitions
			sequence : start -[]-> done { output!(1); output!(2); output := 3; input?(value); writer!(value); updater!(value); value := 2 };
			independent : start -[]-> done { output!(1) & other_output!(2) & input?(value) & writer!(other) };
			no_payload : start -[]-> done { output! & output!(1) };
			no_dequeue_target : start -[]-> done { input? & input?(value) };
			input_actual : start -[]-> done { mixed!(value, other) & value := 2 };
			same_member : start -[]-> done { mixed!(value, value) & other := 2 };
			nested_sequence : start -[]-> done { { input?(value); writer!(value); value := 2 } & { output!(1); output!(2) } };
			nested_sets : start -[]-> done { { writer!(value) & writer!(other) }; { input?(value) & output!(1) } };
			read_only_port_argument : start -[]-> done { port_writer!(value, output) & value := 2 };
			explicit_independent : start -[]-> done { value := 1 & other := 2 };
	**};
	end host.i;
end ValidActionSets;
