package Issue3205
public
    with Base_Types;

    thread worker
    features
        feed : in event data port Base_Types::Integer;
    end worker;

    thread implementation worker.i
    annex behavior_specification {**
        variables
            a, i : Base_Types::Integer;
        states
            start : initial state;
            done : complete final state;
        transitions
            start -[]-> done {
                feed?(i);
                for (i : Base_Types::Integer in 0 .. 2) {
                    feed?(a);
                    forall (j : Base_Types::Integer in 0 .. 2) { a := i + j };
                    feed?
                };
                feed?(i);
                forall (i : Base_Types::Integer in 0 .. 2) {
                    a := i;
                    for (j : Base_Types::Integer in 0 .. 2) { feed?(a) };
                    a := i
                };
                feed?(i)
            };
    **};
    end worker.i;
end Issue3205;
