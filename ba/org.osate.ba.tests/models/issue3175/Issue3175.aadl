package issue3175
public
	with Base_Types;

	-- Every numeric literal form the core AADL grammar admits, written once as an initial value, once inside a value
	-- expression, and once as a transition priority.
	thread literalForms
	features
		trigger : in event port;
	properties
		Dispatch_Protocol => Sporadic;
	end literalForms;

	thread implementation literalForms.impl
		annex behavior_specification {**
			variables
				decimalValue : Base_Types::Integer := 42;
				underscoredValue : Base_Types::Integer := 1_000_000;
				exponentValue : Base_Types::Integer := 2e3;
				basedValue : Base_Types::Integer := 16#ff#;
				basedExponentValue : Base_Types::Integer := 2#1010#e4;
				realValue : Base_Types::Float := 1.25;
				realExponentValue : Base_Types::Float := 1_0.5e2;
			states
				start : initial state;
				ready : complete state;
				done : final state;
			transitions
				start -[]-> ready {
					decimalValue := 8#17#;
					realValue := 2.5e-1
				};
				prioritized [16#10#] : ready -[on dispatch trigger]-> done;
		**};
	end literalForms.impl;
end issue3175;
