package issue3155
public
	-- Every state declaration below is legal AADL; only the transitions violate D.3.(L6), D.3.(L7), and D.3.(L8).
	thread transitionLegality
	end transitionLegality;

	thread implementation transitionLegality.impl
		annex behavior_specification {**
			states
				readyState : initial state;
				waitState : complete state;
				doneState : final state;
			transitions
				waitState -[]-> doneState;
				readyState -[on dispatch]-> waitState;
				doneState -[]-> readyState;
		**};
	end transitionLegality.impl;

	subprogram subprogramLegality
	end subprogramLegality;

	subprogram implementation subprogramLegality.impl
		annex behavior_specification {**
			states
				firstInitial, secondInitial : initial state;
				waitState : complete state;
				firstFinal, secondFinal : final state;
		**};
	end subprogramLegality.impl;

	thread threadLegality
	end threadLegality;

	thread implementation threadLegality.impl
		annex behavior_specification {**
			states
				firstInitial : initial complete state;
				secondInitial : initial state;
		**};
	end threadLegality.impl;

	-- A single transition leaving two complete states breaks D.3.(L7) once, not once per source state.
	thread sharedTransition
	end sharedTransition;

	thread implementation sharedTransition.impl
		annex behavior_specification {**
			states
				readyState : initial state;
				firstWait, secondWait : complete state;
			transitions
				readyState -[on dispatch]-> firstWait;
				firstWait, secondWait -[]-> readyState;
		**};
	end sharedTransition.impl;
end issue3155;
