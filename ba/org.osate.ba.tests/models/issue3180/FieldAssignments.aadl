package FieldAssignments
public
    with Base_Types, Data_Model;

    data Pair
    properties
        Data_Model::Data_Representation => Struct;
        Data_Model::Base_Type => (classifier (Base_Types::Integer), classifier (Base_Types::Integer));
        Data_Model::Element_Names => ("left", "right");
    end Pair;

    data Pairs
    properties
        Data_Model::Data_Representation => Array;
        Data_Model::Base_Type => (classifier (Pair));
        Data_Model::Dimension => (3);
    end Pairs;

    thread worker
    end worker;

    -- Writing one data element of an iterator writes part of the iterator, so D.6 forbids it in both loop forms.
    thread implementation worker.i
    annex behavior_specification {**
        variables
            pairs : Pairs;
            here : Pair;
        states
            start : initial state;
            done : complete final state;
        transitions
            start -[]-> done {
                for (p : Pair in pairs) {
                    p.left := 1;
                    forall (q : Pair in pairs) {
                        p.right := q.left
                    }
                }
            };
    **};
    end worker.i;

    -- The same data elements of an ordinary variable remain writable, and an iterator element remains readable.
    thread implementation worker.j
    annex behavior_specification {**
        variables
            pairs : Pairs;
            here : Pair;
        states
            start : initial state;
            done : complete final state;
        transitions
            start -[]-> done {
                for (p : Pair in pairs) {
                    here.left := p.left;
                    here.right := p.right;
                    here := p
                }
            };
    **};
    end worker.j;
end FieldAssignments;
