package PortUpdated
public
	with Base_Types;

	abstract component
	features
		input: in data port Base_Types::Integer;
	end component;

	abstract implementation component.i
	annex behavior_specification {**
		states
			start: initial state;
			finish: final state;
		transitions
			start -[ input'updated ]-> finish;
	**};
	end component.i;
end PortUpdated;
