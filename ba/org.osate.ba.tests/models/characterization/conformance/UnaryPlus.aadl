package UnaryPlus
public
	with Base_Types;

	subprogram operation
	annex behavior_specification {**
		variables
			value: Base_Types::Integer;
		states
			start: initial state;
			finish: final state;
		transitions
			start -[ ]-> finish { value := +1 };
	**};
	end operation;
end UnaryPlus;
