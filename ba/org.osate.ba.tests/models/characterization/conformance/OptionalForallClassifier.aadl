package OptionalForallClassifier
public
	with Base_Types;

	subprogram operation
	annex behavior_specification {**
		variables
			value: Base_Types::Integer;
		states
			start: initial state;
			finish: final state;
		transitions
			start -[ ]-> finish {
				forall (i in 0 .. 1) {
					value := i
				}
			};
	**};
	end operation;
end OptionalForallClassifier;
