package Issue2445_Holder_Coverage
public
	with Base_Types;
	with Issue2445_Holder_Properties;

	thread holder_source
	prototypes
		fp: in feature Base_Types::Integer;
	features
		prototype_feature: in prototype fp;
	properties
		Issue2445_Holder_Properties::record_property => [
			present => 1;
		];
	annex behavior_specification {**
		variables
			value: Base_Types::Integer;
		states
			s: initial complete final state;
		transitions
			s -[on dispatch]-> s {
				value := #Issue2445_Holder_Properties::record_property.omitted;
				if (#Issue2445_Holder_Properties::enum_type.enabled =
						#Issue2445_Holder_Properties::enum_type.enabled)
					value := fp
				end if
			};
	**};
	end holder_source;
end Issue2445_Holder_Coverage;
