package MissingActionSetSeparator
public
	with Base_Types;
	thread t
	annex behavior_specification {**
		variables x: Base_Types::Integer;
		states s: initial final state;
		transitions s -[]-> s { x := 1 & x := 2 x := 3 };
	**};
	end t;
end MissingActionSetSeparator;
