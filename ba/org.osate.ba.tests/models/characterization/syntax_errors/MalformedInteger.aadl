package MalformedInteger
public
	with Base_Types;
	thread t
	annex behavior_specification {**
		variables x: Base_Types::Integer;
		states s: initial final state;
		transitions s -[]-> s { x := 2#2# };
	**};
	end t;
end MalformedInteger;
