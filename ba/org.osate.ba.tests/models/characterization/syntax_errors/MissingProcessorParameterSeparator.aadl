package MissingProcessorParameterSeparator
public
	thread t
	annex behavior_specification {**
		states s: initial final state;
		transitions s -[]-> s { computation(1 ms) in binding (cpu1 cpu2) };
	**};
	end t;
end MissingProcessorParameterSeparator;
