package Elif
public
	with Base_Types;
	thread t
	annex behavior_specification {**
		variables x: Base_Types::Integer;
		states s: initial final state;
		transitions s -[]-> s { if (true) x := 1 elif (false) x := 2 end if };
	**};
	end t;
end Elif;
