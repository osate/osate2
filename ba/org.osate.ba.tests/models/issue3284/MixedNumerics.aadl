package MixedNumerics
public
	with Data_Model;

	data int_type
		properties
			Data_Model::Data_Representation => Integer;
	end int_type;

	data percent_type
		properties
			Data_Model::Data_Representation => Fixed;
	end percent_type;

	data ratio_type
		properties
			Data_Model::Data_Representation => Float;
	end ratio_type;

	abstract host
	end host;

	abstract implementation host.impl
		subcomponents
			int_value: data int_type;
			fixed_value: data percent_type;
			float_value: data ratio_type;
		annex behavior_specification {**
			states
				start: initial state;
				done: final state;
			transitions
				-- A universal integer mixed with a real denotes a real, so the expression must not come out
				-- integral and must not conform to an integer target.
				mixed: start -[]-> done {
					int_value := 1 + 1.0
				};
				-- mod and rem stay integer operations even though their left operand conforms to a real now.
				modulo: start -[]-> done {
					int_value := 1 mod fixed_value
				};
				-- Classifier-typed numerics still do not mix, in an assignment or as operands.
				named: start -[]-> done {
					int_value := float_value
				};
				related: start -[]-> done {
					float_value := int_value + float_value
				};
		**};
	end host.impl;
end MixedNumerics;
