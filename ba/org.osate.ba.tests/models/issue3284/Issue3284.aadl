package Issue3284
public
	with Data_Model;

	data percent_type
		properties
			Data_Model::Data_Representation => Fixed;
			Data_Model::Measurement_Unit => "Percent";
	end percent_type;

	data ratio_type
		properties
			Data_Model::Data_Representation => Float;
	end ratio_type;

	data flag_type
		properties
			Data_Model::Data_Representation => Boolean;
	end flag_type;

	abstract host
		features
			reading: in data port percent_type;
			trigger: in event port;
	end host;

	abstract implementation host.impl
		subcomponents
			fixed_value: data percent_type;
			float_value: data ratio_type;
			flag_value: data flag_type;
		annex behavior_specification {**
			states
				start: initial state;
				done: final state;
			transitions
				-- An integer literal is a universal integer. An operator defined for the numeric representations
				-- accepts it against a fixed point or floating point operand, in either position.
				scaled: start -[]-> done {
					fixed_value := reading * 2;
					fixed_value := 2 * reading;
					float_value := float_value / 100;
					float_value := 100 / float_value
				};
				compared: start -[]-> done {
					flag_value := reading >= 0;
					flag_value := 0 <= reading;
					flag_value := float_value > 1
				};
				-- A port count value is a universal integer too.
				counted: start -[]-> done {
					fixed_value := reading * trigger'count
				};
				-- A universal integer conforms directly, not only as an operand.
				assigned: start -[]-> done {
					fixed_value := 0;
					float_value := 1
				};
		**};
	end host.impl;
end Issue3284;
