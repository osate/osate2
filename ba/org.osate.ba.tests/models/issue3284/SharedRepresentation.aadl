package SharedRepresentation
public
	with Data_Model;

	data first_integer
		properties
			Data_Model::Data_Representation => Integer;
	end first_integer;

	data second_integer
		properties
			Data_Model::Data_Representation => Integer;
	end second_integer;

	data first_float
		properties
			Data_Model::Data_Representation => Float;
	end first_float;

	data second_float
		properties
			Data_Model::Data_Representation => Float;
	end second_float;

	data first_fixed
		properties
			Data_Model::Data_Representation => Fixed;
	end first_fixed;

	data second_fixed
		properties
			Data_Model::Data_Representation => Fixed;
	end second_fixed;

	data first_flag
		properties
			Data_Model::Data_Representation => Boolean;
	end first_flag;

	data second_flag
		properties
			Data_Model::Data_Representation => Boolean;
	end second_flag;

	data first_choice
		properties
			Data_Model::Data_Representation => Enum;
			Data_Model::Enumerators => ("one", "two");
	end first_choice;

	data second_choice
		properties
			Data_Model::Data_Representation => Enum;
			Data_Model::Enumerators => ("one", "two");
	end second_choice;

	abstract host
	end host;

	abstract implementation host.impl
		subcomponents
			int_a: data first_integer;
			int_b: data second_integer;
			float_a: data first_float;
			float_b: data second_float;
			fixed_a: data first_fixed;
			fixed_b: data second_fixed;
			flag_a: data first_flag;
			flag_b: data second_flag;
			choice_a: data first_choice;
			choice_b: data second_choice;
		annex behavior_specification {**
			states
				start: initial state;
				done: final state;
			transitions
				-- Numeric types that share a data representation conform, as a target and as operands.
				shared: start -[]-> done {
					int_a := int_b;
					float_a := float_b;
					fixed_a := fixed_b;
					int_a := int_b + int_a
				};
				-- An integer value widens to a floating point target.
				widened: start -[]-> done {
					float_a := int_a
				};
				-- Mixing integer and floating point operands gives a floating point result.
				promoted: start -[]-> done {
					float_a := int_a + float_b
				};
				-- Integer, fixed point, and floating point are ordered, so a conversion up that order keeps the value.
				widened_order: start -[]-> done {
					fixed_a := int_a;
					float_a := fixed_a
				};
				-- A conversion down that order may lose precision, so it is a warning rather than a note.
				narrowed: start -[]-> done {
					int_a := float_a;
					int_a := fixed_a;
					fixed_a := float_a
				};
				-- Booleans and enumerations are not numeric, so a shared representation is not enough for them.
				unrelaxed: start -[]-> done {
					flag_a := flag_b;
					choice_a := choice_b
				};
		**};
	end host.impl;
end SharedRepresentation;
