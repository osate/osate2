package NonDataIteratorClassifier
public
    with Base_Types;

    thread helper
    end helper;

    thread implementation helper.impl
    end helper.impl;

    thread worker
    end worker;

    -- The D.6 production spells the written iterator classifier data_unique_component_classifier_reference, so a
    -- classifier of any other category is not one. The strict model has nothing to carry it: an iterative variable is
    -- typed by a data classifier alone, and making the classifier optional must not turn a rejected declaration into
    -- one whose type is inferred from the iterated values instead.
    thread implementation worker.i
    annex behavior_specification {**
        variables
            total : Base_Types::Integer;
        states
            start : initial state;
            done : complete final state;
        transitions
            written_thread_type : start -[]-> done {
                for (step : helper in 0 .. 2) {
                    total := step + total
                }
            };
            written_thread_implementation : start -[]-> done {
                forall (other : helper.impl in 0 .. 2) {
                    total := other + total
                }
            };
    **};
    end worker.i;
end NonDataIteratorClassifier;
