package Issue3173
public
    with Base_Types, Data_Model;

    data Pair
    properties
        Data_Model::Data_Representation => Struct;
        Data_Model::Base_Type => (classifier (Base_Types::Integer), classifier (Base_Types::Integer));
        Data_Model::Element_Names => ("left", "right");
    end Pair;

    data Pairs
    properties
        Data_Model::Data_Representation => Array;
        Data_Model::Base_Type => (classifier (Pair));
        Data_Model::Dimension => (3);
    end Pairs;

    thread worker
    features
        readings : in event data port Base_Types::Integer;
    end worker;

    -- AS5506/3 Rev A D.6 makes ': data_unique_component_classifier_reference' optional in the for and the forall
    -- construct. The iterated values then determine the element type: an integer range makes the iterator an integer,
    -- while an input event data port and a data component array each supply the classifier of their own elements.
    --
    -- Every loop body names the iterator as the first operand of an arithmetic expression. An operator is defined by
    -- the type of its first operand, so an iterator left without a type is reported even though the type conformance
    -- check between operands is currently disabled.
    thread implementation worker.i
    subcomponents
        history : data Base_Types::Integer [3];
    annex behavior_specification {**
        variables
			total : Base_Types::Integer := 0;
			pairs : Pairs { Data_Model::Initial_Value => ("[]"); };
        states
            start : initial state;
            done : complete final state;
        transitions
            range_loop : start -[]-> done {
                for (step in 0 .. 2) {
                    total := step + total
                }
            };
            range_forall : start -[]-> done {
                forall (other in 0 .. 2) {
                    total := other - total
                }
            };
            queue_loop : start -[]-> done {
                for (sample in readings) {
                    total := sample + total
                }
            };
            array_loop : start -[]-> done {
                for (element in history) {
                    total := element + total
                }
            };
            data_model_array_forall : start -[]-> done {
                forall (entry in pairs) {
                    total := entry.left + entry.right
                }
            };
            written_classifier : start -[]-> done {
                for (typed : Base_Types::Integer in 0 .. 2) {
                    total := typed + total
                }
            };
    **};
    end worker.i;
end Issue3173;
