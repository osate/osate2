package InvalidTriggers
public
	with Base_Types;

	feature group cmd_signals
		features
			increment_step: in event data port Base_Types::Integer;
			completion: out event port;
	end cmd_signals;

	device motor
		features
			signals: feature group inverse of cmd_signals;
			reading: in data port Base_Types::Integer;
			wake: in event port;
		properties
			Dispatch_Protocol => Aperiodic;
	end motor;

	device implementation motor.impl
		subcomponents
			state_value: data Base_Types::Integer;
		annex behavior_specification {**
			states
				ready: initial complete state;
			transitions
				-- A name the model declares nowhere: the feature group has no element of that name, and neither has
				-- the device.
				missing: ready -[on dispatch signals.step_done]-> ready;
				-- A data port carries no event to dispatch on.
				wrong_kind: ready -[on dispatch reading]-> ready;
				-- Neither does a data subcomponent.
				not_a_port: ready -[on dispatch state_value]-> ready;
				-- One real event port and one name that does not exist. The conjunction must not quietly keep only
				-- the operand it can represent and dispatch on that alone.
				conjoined: ready -[on dispatch wake and signals.step_done]-> ready;
		**};
	end motor.impl;
end InvalidTriggers;
