package Issue3290
public
	with Base_Types;

	feature group cmd_signals
		features
			increment_step: in event data port Base_Types::Integer;
			completion: out event port;
	end cmd_signals;

	subprogram routine
	end routine;

	thread host
		features
			wake: in event port;
			command: in event data port Base_Types::Integer;
			signals: feature group inverse of cmd_signals;
			rpc: provides subprogram access routine;
		properties
			Dispatch_Protocol => Sporadic;
			Period => 100 ms;
	end host;

	thread implementation host.impl
		annex behavior_specification {**
			states
				waiting: initial complete state;
			transitions
				-- An event port and an event data port of the component are dispatch triggers.
				event_trigger: waiting -[on dispatch wake]-> waiting;
				data_event_trigger: waiting -[on dispatch command]-> waiting;
				-- So is an incoming event port reached through a feature group.
				group_trigger: waiting -[on dispatch signals.completion]-> waiting;
				-- Every operand of a conjunction and of a disjunction is checked, and each of these is a port.
				conjunction: waiting -[on dispatch wake and command]-> waiting;
				disjunction: waiting -[on dispatch wake or signals.completion]-> waiting;
				-- A subprogram access named as the whole condition is a dispatch trigger condition in its own right,
				-- which the translator installs directly instead of as a trigger of a conjunction.
				subprogram_trigger: waiting -[on dispatch rpc]-> waiting;
		**};
	end host.impl;
end Issue3290;
